# ---------------------------------------------------------------------------
# apps/server/.env
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Postgres connection used for queries. On Neon this is the POOLED url.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Unpooled connection, used by Prisma for migrations only.
# Required: schema.prisma declares directUrl, and migrations fail over a pooled
# connection. On Neon this is the url WITHOUT "-pooler" in the host.
DIRECT_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Origin allowed by CORS and Socket.io. Must match where the web app is served.
CLIENT_URL=http://localhost:3000

# Port the Express/Socket.io server listens on.
PORT=3001
