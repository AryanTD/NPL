# ---------------------------------------------------------------------------
# apps/web/.env.local
# Copy to .env.local and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Where the Express/Socket.io server lives. Public — shipped to the browser.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Auth.js v5
# These are read IMPLICITLY by Auth.js from the environment — you will not find
# them referenced in application code. auth.ts registers the bare Google and
# Resend providers, and Auth.js resolves their credentials by convention.
# ---------------------------------------------------------------------------

# Signs the JWT session cookie. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials, from the Google Cloud console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend API key for email magic-link sign-in. Free tier allows 100 emails/day.
AUTH_RESEND_KEY=re_...

# ---------------------------------------------------------------------------
# Database — the web app talks to Postgres directly for the Auth.js adapter and
# for server components such as the players page. Same values as apps/server.
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
